{
  "name": "@overprint/web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:plugin": "node scripts/copy-plugin.mjs",
    "dev": "bun run prepare:plugin && node scripts/dev.mjs",
    "build": "node scripts/build.mjs standalone",
    "preview": "node .output/standalone/server/index.mjs",
    "typecheck": "nuxt typecheck && node --test tests/server/i18n.test.ts",
    "test": "playwright test",
    "postinstall": "nuxt prepare",
    "test:server": "node --test tests/server/*.test.ts",
    "build:cloudflare": "node scripts/build.mjs cloudflare",
    "start": "node scripts/start.mjs",
    "preview:cloudflare": "cd ../.. && wrangler pages dev --ip 127.0.0.1 --port 4318",
    "test:cloudflare": "node --test tests/runtime/cloudflare.test.ts",
    "test:standalone": "node --test tests/runtime/standalone.test.ts",
    "format": "prettier --write \"app/**/*.vue\"",
    "format:check": "prettier --check \"app/**/*.vue\""
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.46.0",
    "@nuxtjs/i18n": "^10.6.0",
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.3",
    "nuxt": "^4.5.2",
    "three": "^0.186.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@overprint/kicad": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.186.0",
    "miniflare": "^5.20260915.0-alpha",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.132.0"
  },
  "license": "MIT",
  "version": "0.1.0-alpha.1"
}
