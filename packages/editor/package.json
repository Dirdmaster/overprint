{
  "name": "@overprint/editor",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "license": "MIT",
  "description": "Embeddable PCB artwork editor with customizable components for React, Vue, Next.js, Nuxt, and vanilla JavaScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dirdmaster/overprint.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/packages/editor/src/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./react": {
      "types": "./dist/types/packages/editor/src/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/packages/editor/src/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "bun run test:unit && playwright test",
    "test:unit": "bun test tests/history.test.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "fflate": "^0.8.3",
    "clipper-lib": "^6.4.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.11",
    "@types/three": "^0.186.0",
    "@types/clipper-lib": "^6.4.0",
    "@playwright/test": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.42"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
